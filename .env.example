# App
APP_URL=http://localhost:3000
NODE_ENV=development
# Random 32+ char secret used to sign session cookies (openssl rand -hex 32)
SESSION_SECRET=dev-only-insecure-change-me-0000000000000000
ADMIN_EMAILS=anthony@profullstack.com

# Database: Postgres in production (the client is @profullstack/libsql-pg; Turso is
# no longer read, the data was copied to Postgres with `npx libsql-pg copy` in 2026-09)
# or a local libSQL file for development and the tests.
# DATABASE_URL=postgres://localhost:5432/aiornot   # add user:password@ before the host as needed
# Local dev: file: URL -> embedded local SQLite (auth token unused/ignored).
DATABASE_URL=file:./local.db

# Auth / email (optional in dev — verification links are logged to console if unset)
RESEND_API_KEY=
EMAIL_FROM=AIorNot.vote <hello@aiornot.vote>
EMAIL_VERIFICATION_TTL_MINUTES=30

# Uploads / storage (S3-compatible; Cloudflare R2 by default)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
MAX_IMAGE_UPLOAD_MB=12
MAX_VIDEO_UPLOAD_MB=75
MAX_VIDEO_DURATION_SECONDS=30

# Seed data
UNSPLASH_ACCESS_KEY=
OPENAI_API_KEY=
AI_IMAGE_MODEL=gpt-image-1
SEED_BATCH_SIZE=25

# RSS / rate-limit salts (openssl rand -hex 16)
RSS_CACHE_SECONDS=300
VOTE_SALT=dev-vote-salt
SUBMISSION_SALT=dev-submission-salt
RATE_LIMIT_SALT=dev-rate-limit-salt

# Analytics (optional)
POSTHOG_KEY=
POSTHOG_HOST=

# Crawl gateway (@profullstack/x402-gateway): AI training crawlers pay $1/day over
# x402. A SCOPED CoinPay key (payments:create) and the EVM address that receives
# the USDC. Unset = crawlers still get 402, nothing sold.
COINPAY_X402_KEY=
CRAWL_PAY_TO=

# Web Push (@profullstack/notifications). Read at run time; the browser fetches the
# public key from /api/push/vapid-public-key. Unset = push off (that route answers 503).
# New pair: node -e "import('@profullstack/notifications/server').then(m => console.log(m.generateVapidKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@aiornot.vote
