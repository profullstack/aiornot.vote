# syntax=docker/dockerfile:1
# aiornot.vote on Bun. Hand-written, NOT generated by nixpacks: do not regenerate.
# The path stays .nixpacks/Dockerfile because dev2's compose names it.
#
# One container, as before: migrations + seeds, then the media daemon
# (services/worker) in the background and the Next.js web app in front.
# Bun runs the TypeScript CLIs directly (no tsx) and `next start` (bun --bun).

FROM oven/bun:1.4.0-slim AS deps
WORKDIR /app
COPY package.json bun.lock ./
COPY apps/web/package.json apps/web/
COPY packages/db/package.json packages/db/
COPY packages/seed/package.json packages/seed/
COPY services/worker/package.json services/worker/
RUN bun install --frozen-lockfile

FROM deps AS build
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production
RUN bun run build && rm -rf apps/web/.next/cache

# Runtime dependencies only (no vitest/eslint/typescript/@libsql/client).
FROM oven/bun:1.4.0-slim AS prod-deps
WORKDIR /app
COPY package.json bun.lock ./
COPY apps/web/package.json apps/web/
COPY packages/db/package.json packages/db/
COPY packages/seed/package.json packages/seed/
COPY services/worker/package.json services/worker/
RUN bun install --frozen-lockfile --production

FROM oven/bun:1.4.0-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000
# Bun 1.4 workspaces use the isolated linker (node_modules/.bun + per-package
# symlinks), so the whole /app tree comes across, not just root node_modules.
COPY --from=prod-deps --chown=bun:bun /app ./
# dev2 checkouts are group-only (660/2770): every source COPY needs --chown.
COPY --chown=bun:bun tsconfig.base.json ./
COPY --chown=bun:bun packages/db packages/db
COPY --chown=bun:bun packages/seed packages/seed
COPY --chown=bun:bun services/worker services/worker
COPY --chown=bun:bun apps/web apps/web
COPY --from=build --chown=bun:bun /app/apps/web/.next apps/web/.next
USER bun
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD bun -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"
CMD ["sh", "-c", "cd /app/packages/db && bun migrate.ts && bun seed-tags.ts && bun seed-demo.ts && cd /app/services/worker && (bun jobs/generate-media-daemon.ts &) && cd /app/apps/web && exec bun --bun next start -p ${PORT:-3000}"]
