{
  "name": "aiornot.vote",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --filter @aiornot/web dev",
    "build": "bun --filter @aiornot/web build",
    "start": "bun --filter @aiornot/web start",
    "lint": "bun --filter @aiornot/web lint",
    "migrate": "bun --filter @aiornot/db migrate",
    "seed:tags": "bun --filter @aiornot/db seed:tags",
    "seed:demo": "bun --filter @aiornot/db seed:demo",
    "seed:unsplash": "bun --filter @aiornot/worker seed:unsplash",
    "seed:ai-variants": "bun --filter @aiornot/worker seed:ai-variants",
    "recalc:leaderboards": "bun --filter @aiornot/worker recalc:leaderboards",
    "seed:pool": "bun --filter @aiornot/worker seed:pool",
    "seed:library": "bun --filter @aiornot/worker seed:library",
    "draw:prizes": "bun --filter @aiornot/worker draw:prizes",
    "gen:tips": "bun --filter @aiornot/worker gen:tips",
    "test": "bun --filter @aiornot/web test",
    "typecheck": "bun --filter @aiornot/web typecheck"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "sharp",
    "esbuild",
    "@node-rs/argon2"
  ],
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "overrides": {
    "postcss": "^8.5.31",
    "nanoid": "^3.3.20",
    "source-map-js": "^1.2.2",
    "js-yaml": "^4.3.2",
    "vite": "^7.3.7"
  }
}
